# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority"
# Database name (optional, defaults to "trs")
MONGODB_DB="trs"

# JWT signing secret for admin sessions. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Admin login (used by `pnpm db:seed` to create the admin user)
ADMIN_EMAIL="admin@trsrealty.in"
ADMIN_PASSWORD="Coimbatore@123"

# Vercel Blob read/write token (auto-injected on Vercel; needed for local uploads).
# Get it from the Vercel dashboard → Storage → your Blob store → ".env.local" tab.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
